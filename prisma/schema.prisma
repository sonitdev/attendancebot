generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum LifecycleStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum AssignmentStatus {
  ACTIVE
  CANCELLED
  COMPLETED
}

enum AttendanceStatus {
  NOT_STARTED
  ON_TIME
  LATE
  ABSENT
  APPROVED_LEAVE
  EARLY_CHECKOUT
  MISSING_CHECKOUT
  OUTSIDE_GEOFENCE
  LOW_ACCURACY
  PENDING_REVIEW
  COMPLETED
}

enum VerificationStatus {
  VERIFIED
  OUTSIDE_GEOFENCE
  LOW_ACCURACY
  LOCATION_UNAVAILABLE
  MANAGER_REVIEW
  MANAGER_OVERRIDE
}

enum AttendanceEventType {
  CHECK_IN_ATTEMPT
  CHECK_IN_SUCCESS
  CHECK_IN_OUTSIDE_GEOFENCE
  CHECK_IN_LOW_ACCURACY
  CHECK_OUT_ATTEMPT
  CHECK_OUT_SUCCESS
  MANUAL_CORRECTION
  MANAGER_OVERRIDE
}

enum AttendanceAction {
  CHECK_IN
  CHECK_OUT
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PositionHistorySource {
  MANAGER_ASSIGNED
  WORKER_REQUEST_APPROVED
  IMPORT
}

enum PositionRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum RegistrationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BulkBatchStatus {
  PREVIEW_GENERATED
  PROCESSING
  COMPLETED
  FAILED
}

enum BulkResultStatus {
  CREATED
  SKIPPED_CONFLICT
  SKIPPED_INACTIVE
  FAILED
}

enum TelegramDeliveryKind {
  TEXT
  PHOTO
  SALES_REPORT
}

enum TelegramDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model Organization {
  id String @id @default(cuid())
  slug String @unique
  name String
  logoUrl String?
  brandPrimaryColor String @default("#023F26")
  brandAccentColor String @default("#C4D701")
  defaultLocale String @default("km")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  employees Employee[]
  positions Position[]
  positionHistories EmployeePositionHistory[]
  positionRequests PositionRequest[]
  registrationRequests RegistrationRequest[]
  pendingTelegramProjectSelections PendingTelegramProjectSelection[]
  workerGroups WorkerGroup[]
  workerGroupMembers WorkerGroupMember[]
  bulkAssignmentBatches BulkAssignmentBatch[]
  projects Project[]
  schedules WorkSchedule[]
  users User[]
  roles Role[]
  permissions Permission[]
  telegramAccounts TelegramAccount[]
  telegramOwners TelegramOrganizationOwner[]
  sites Site[]
  assignments Assignment[]
  attendanceRecords AttendanceRecord[]
  attendanceEvents AttendanceEvent[]
  attendanceRequests AttendanceRequest[]
  attendanceCorrections AttendanceCorrection[]
  visitLogs VisitLog[]
  telegramReportGroups TelegramReportGroup[]
  workerProjects WorkerProject[]
  telegramDeliveries TelegramDelivery[]
  auditLogs AuditLog[]
  outlets Outlet[]
  dailySalesReports DailySalesReport[]
  telegramConversationStates TelegramConversationState[]
  userProjectScopes UserProjectScope[]
  userSiteScopes UserSiteScope[]
}

// A real organization owner can pair their Telegram account without becoming a
// worker. This is the secure bridge required before a Telegram group can be
// attached to a newly registered organization.
model TelegramOrganizationOwner {
  id String @id @default(cuid())
  organizationId String @unique
  userId String
  setupCode String @unique
  setupCodeExpiresAt DateTime
  setupCodeUsedAt DateTime?
  telegramUserId String? @unique
  telegramUsername String?
  pairedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([setupCode, setupCodeExpiresAt])
}

model User {
  id String @id @default(cuid())
  organizationId String
  email String
  passwordHash String?
  status LifecycleStatus @default(ACTIVE)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  roles UserRole[]
  requestedBulkBatches BulkAssignmentBatch[]
  projectScopes UserProjectScope[]
  siteScopes UserSiteScope[]
  telegramOwnerPairings TelegramOrganizationOwner[]
  @@unique([organizationId, email])
}

model Role {
  id String @id @default(cuid())
  organizationId String
  code String
  name String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  users UserRole[]
  permissions RolePermission[]
  @@unique([organizationId, code])
}

model Permission {
  id String @id @default(cuid())
  organizationId String
  code String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  roles RolePermission[]
  @@unique([organizationId, code])
}

model UserRole {
  userId String
  roleId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)
  @@id([userId, roleId])
}

model RolePermission {
  roleId String
  permissionId String
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  @@id([roleId, permissionId])
}

model Position {
  id String @id @default(cuid())
  organizationId String
  code String
  name String
  description String?
  status LifecycleStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employees Employee[] @relation("EmployeeCurrentPosition")
  history EmployeePositionHistory[]
  positionRequests PositionRequest[] @relation("RequestedPosition")

  @@unique([organizationId, code])
  @@index([organizationId, status])
}

model EmployeePositionHistory {
  id String @id @default(cuid())
  organizationId String
  employeeId String
  positionId String
  effectiveFrom DateTime @default(now())
  effectiveTo DateTime?
  source PositionHistorySource @default(MANAGER_ASSIGNED)
  assignedByUserId String?
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  position Position @relation(fields: [positionId], references: [id], onDelete: Restrict)

  @@index([organizationId, employeeId, effectiveFrom])
  @@index([organizationId, positionId])
}

model PositionRequest {
  id String @id @default(cuid())
  organizationId String
  employeeId String
  requestedPositionId String
  requestedAt DateTime @default(now())
  status PositionRequestStatus @default(PENDING)
  reviewedAt DateTime?
  reviewedByUserId String?
  reviewNote String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  requestedPosition Position @relation("RequestedPosition", fields: [requestedPositionId], references: [id], onDelete: Restrict)

  @@index([organizationId, status, requestedAt])
  @@index([organizationId, employeeId])
}

model RegistrationRequest {
  id String @id @default(cuid())
  organizationId String
  telegramUserId String
  phone String
  normalizedPhone String
  telegramUsername String?
  telegramFirstName String?
  telegramLastName String?
  telegramPhotoUrl String?
  status RegistrationRequestStatus @default(PENDING)
  requestedAt DateTime @default(now())
  reviewedAt DateTime?
  reviewedByUserId String?
  reviewNote String?
  createdEmployeeId String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, status, requestedAt])
  @@index([organizationId, normalizedPhone])
  @@index([organizationId, telegramUserId])
}

// The group context selected by a worker before they have completed private
// bot registration.  It deliberately stores only the next-project intent;
// it never changes historical attendance or an existing project connection.
model PendingTelegramProjectSelection {
  id String @id @default(cuid())
  organizationId String
  telegramUserId String
  projectId String
  sourceChatId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([organizationId, projectId])
  @@unique([organizationId, telegramUserId])
}

model WorkerGroup {
  id String @id @default(cuid())
  organizationId String
  code String
  name String
  description String?
  status LifecycleStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  members WorkerGroupMember[]
  telegramReportGroups TelegramReportGroup[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
}

model WorkerGroupMember {
  id String @id @default(cuid())
  organizationId String
  workerGroupId String
  employeeId String
  joinedAt DateTime @default(now())
  leftAt DateTime?
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workerGroup WorkerGroup @relation(fields: [workerGroupId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([organizationId, workerGroupId, leftAt])
  @@index([organizationId, employeeId, leftAt])
}

model BulkAssignmentBatch {
  id String @id @default(cuid())
  organizationId String
  targetSiteId String
  scheduleId String
  startsOn DateTime @db.Date
  endsOn DateTime? @db.Date
  requestedByUserId String
  idempotencyKey String?
  previewId String @unique
  previewExpiresAt DateTime
  snapshotWorkerIds Json
  transferOption Boolean @default(false)
  status BulkBatchStatus @default(PREVIEW_GENERATED)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  targetSite Site @relation(fields: [targetSiteId], references: [id], onDelete: Restrict)
  schedule WorkSchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  requestedByUser User @relation(fields: [requestedByUserId], references: [id], onDelete: Restrict)
  results BulkAssignmentResult[]

  @@unique([organizationId, requestedByUserId, idempotencyKey])
  @@index([organizationId, createdAt])
}

model BulkAssignmentResult {
  id String @id @default(cuid())
  batchId String
  employeeId String
  status BulkResultStatus
  reasonCode String?
  safeMessage String?
  assignmentId String?
  createdAt DateTime @default(now())

  batch BulkAssignmentBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  assignment Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  @@index([batchId, status])
}

model Employee {
  id String @id @default(cuid())
  organizationId String
  employeeCode String
  fullName String
  phone String?
  normalizedPhone String?
  jobTitle String?
  avatarUrl String?
  currentPositionId String?
  currentProjectId String?
  status LifecycleStatus @default(ACTIVE)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  currentPosition Position? @relation("EmployeeCurrentPosition", fields: [currentPositionId], references: [id], onDelete: SetNull)
  currentProject Project? @relation("EmployeeCurrentProject", fields: [currentProjectId], references: [id], onDelete: SetNull)
  positionHistory EmployeePositionHistory[]
  positionRequests PositionRequest[]
  workerGroupMemberships WorkerGroupMember[]
  bulkAssignmentResults BulkAssignmentResult[]
  telegramAccount TelegramAccount?
  assignments Assignment[]
  attendance AttendanceRecord[]
  visitLogs VisitLog[]
  projectConnections WorkerProject[]
  dailySalesReports DailySalesReport[]
  @@unique([organizationId, employeeCode])
  @@unique([organizationId, normalizedPhone])
  @@index([organizationId, status])
  @@index([organizationId, currentPositionId, status])
}

model TelegramAccount {
  id String @id @default(cuid())
  organizationId String
  employeeId String @unique
  telegramUserId String
  username String?
  firstName String?
  lastName String?
  photoUrl String?
  linkedAt DateTime @default(now())
  lastVerifiedAt DateTime?
  status LifecycleStatus @default(ACTIVE)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId, telegramUserId])
  @@index([telegramUserId])
  @@unique([organizationId, telegramUserId])
}

// A group is connected by a verified worker, but remains inactive until an
// administrator deliberately assigns it to a site or team. This prevents a
// chat from receiving organization attendance data merely because the bot was
// added to it.
model TelegramReportGroup {
  id String @id @default(cuid())
  organizationId String
  chatId String
  title String?
  connectedByEmployeeId String?
  siteId String?
  workerGroupId String?
  status LifecycleStatus @default(INACTIVE)
  connectedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  site Site? @relation(fields: [siteId], references: [id], onDelete: SetNull)
  workerGroup WorkerGroup? @relation(fields: [workerGroupId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@unique([organizationId, chatId])
}

model Project {
  id String @id @default(cuid())
  organizationId String
  code String
  name String
  telegramChatId String?
  workMode String @default("SITE")
  telegramConnectionStatus String @default("PENDING")
  telegramConnectedAt DateTime?
  telegramHealthCheckedAt DateTime?
  telegramHealthError String?
  status ProjectStatus @default(DRAFT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sites Site[]
  currentWorkers Employee[] @relation("EmployeeCurrentProject")
  workerConnections WorkerProject[]
  attendanceRecords AttendanceRecord[]
  adjustedAttendanceRecords AttendanceRecord[] @relation("AdjustedAttendanceProject")
  visitLogs VisitLog[]
  pendingTelegramSelections PendingTelegramProjectSelection[]
  correctionProjects AttendanceCorrection[] @relation("CorrectionProject")
  outlets Outlet[]
  @@unique([organizationId, telegramChatId])
  dailySalesReports DailySalesReport[]
  userScopes UserProjectScope[]
  @@unique([organizationId, code])
  @@index([organizationId, status])
}

model WorkerProject {
  id String @id @default(cuid())
  organizationId String
  employeeId String
  projectId String
  connectedAt DateTime @default(now())
  lastSelectedAt DateTime?
  authorizationStatus String @default("AUTHORIZED")
  lastVerifiedAt DateTime?
  revokedAt DateTime?
  lastVerificationResult String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([employeeId, projectId])
  @@index([organizationId, employeeId])
  @@index([organizationId, projectId])
}

model Site {
  id String @id @default(cuid())
  organizationId String
  projectId String
  name String
  latitude Decimal @db.Decimal(9, 6)
  longitude Decimal @db.Decimal(9, 6)
  allowedRadiusMeters Int
  timezone String
  status LifecycleStatus @default(ACTIVE)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  assignments Assignment[]
  visitLogs VisitLog[]
  bulkAssignmentBatches BulkAssignmentBatch[]
  telegramReportGroups TelegramReportGroup[]
  attendanceRecords AttendanceRecord[]
  userScopes UserSiteScope[]
  @@index([organizationId, projectId, status])
}

model UserProjectScope {
  id String @id @default(cuid())
  organizationId String
  userId String
  projectId String
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([organizationId, userId])
  @@index([organizationId, projectId])
}

model UserSiteScope {
  id String @id @default(cuid())
  organizationId String
  userId String
  siteId String
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([userId, siteId])
  @@index([organizationId, userId])
  @@index([organizationId, siteId])
}

model WorkSchedule {
  id String @id @default(cuid())
  organizationId String
  name String
  timezone String
  startTime String
  endTime String
  graceMinutes Int @default(0)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignments Assignment[]
  bulkAssignmentBatches BulkAssignmentBatch[]
}

model Assignment {
  id String @id @default(cuid())
  organizationId String
  employeeId String
  siteId String
  scheduleId String
  startsOn DateTime @db.Date
  endsOn DateTime? @db.Date
  status AssignmentStatus @default(ACTIVE)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  site Site @relation(fields: [siteId], references: [id], onDelete: Restrict)
  schedule WorkSchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  attendance AttendanceRecord[]
  visitLogs VisitLog[]
  bulkAssignmentResults BulkAssignmentResult[]
  @@index([employeeId, startsOn, endsOn, status])
  @@index([organizationId, employeeId, status, startsOn, endsOn])
  @@index([organizationId, siteId, startsOn, status])
}

model AttendanceRecord {
  id String @id @default(cuid())
  organizationId String
  employeeId String
  assignmentId String
  projectId String
  siteId String
  telegramChatId String?
  attendanceDate DateTime @db.Date
  checkInAt DateTime?
  checkOutAt DateTime?
  checkInLatitude Decimal? @db.Decimal(9, 6)
  checkInLongitude Decimal? @db.Decimal(9, 6)
  checkInAccuracyMeters Decimal? @db.Decimal(8, 2)
  checkInDistanceMeters Decimal? @db.Decimal(10, 2)
  checkInVerification VerificationStatus?
  checkInPhotoPath String?
  checkInStatus AttendanceStatus?
  checkOutLatitude Decimal? @db.Decimal(9, 6)
  checkOutLongitude Decimal? @db.Decimal(9, 6)
  checkOutAccuracyMeters Decimal? @db.Decimal(8, 2)
  checkOutDistanceMeters Decimal? @db.Decimal(10, 2)
  checkOutVerification VerificationStatus?
  checkOutStatus AttendanceStatus?
  status AttendanceStatus @default(NOT_STARTED)
  adjustedCheckInAt DateTime?
  adjustedCheckOutAt DateTime?
  adjustedStatus AttendanceStatus?
  adjustedProjectId String?
  workDurationMinutes Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  adjustedProject Project? @relation("AdjustedAttendanceProject", fields: [adjustedProjectId], references: [id], onDelete: Restrict)
  site Site @relation(fields: [siteId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  events AttendanceEvent[]
  corrections AttendanceCorrection[]
  telegramDeliveries TelegramDelivery[]
  dailySalesReport DailySalesReport?
  visitLogs VisitLog[]
  @@unique([assignmentId, attendanceDate])
  @@index([organizationId, attendanceDate])
  @@index([organizationId, attendanceDate, createdAt])
  @@index([organizationId, attendanceDate, status])
  @@index([organizationId, attendanceDate, adjustedStatus])
  @@index([organizationId, employeeId, checkOutAt, checkInAt])
  @@index([organizationId, projectId, attendanceDate])
  @@index([organizationId, adjustedProjectId, attendanceDate])
}

model TelegramDelivery {
  id String @id @default(cuid())
  organizationId String
  attendanceRecordId String
  kind TelegramDeliveryKind
  chatId String
  text String
  storagePath String?
  status TelegramDeliveryStatus @default(PENDING)
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  telegramMessageId String?
  lastError String?
  createdAt DateTime @default(now())
  sentAt DateTime?
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  attendanceRecord AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Restrict)

  @@unique([attendanceRecordId, kind])
  @@index([status, nextAttemptAt])
  @@index([organizationId, status, nextAttemptAt, createdAt])
  @@index([organizationId, createdAt])
}

model AttendanceEvent {
  id String @id @default(cuid())
  attendanceRecordId String?
  organizationId String
  type AttendanceEventType
  occurredAt DateTime @default(now())
  metadata Json?
  attendanceRecord AttendanceRecord? @relation(fields: [attendanceRecordId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId, occurredAt])
}

model VisitLog {
  id String @id @default(cuid())
  organizationId String
  employeeId String
  assignmentId String
  siteId String
  projectId String
  attendanceRecordId String?
  visitedAt DateTime @default(now())
  latitude Decimal @db.Decimal(9, 6)
  longitude Decimal @db.Decimal(9, 6)
  accuracyMeters Decimal @db.Decimal(8, 2)
  distanceMeters Decimal @db.Decimal(10, 2)
  verification VerificationStatus
  proofPhotoPath String
  customerName String?
  note String?
  outletId String?
  visitResult String?
  followUpRequired Boolean @default(false)
  followUpAt DateTime?
  potentialOrderQuantity Int?
  requestedDiscountPerItem Decimal? @db.Decimal(12, 2)
  idempotencyKey String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  site Site @relation(fields: [siteId], references: [id], onDelete: Restrict)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  attendanceRecord AttendanceRecord? @relation(fields: [attendanceRecordId], references: [id], onDelete: Restrict)
  outlet Outlet? @relation(fields: [outletId], references: [id], onDelete: SetNull)
  reportVisits DailySalesReportVisit[]
  @@unique([organizationId, employeeId, idempotencyKey])
  @@index([organizationId, employeeId, visitedAt])
  @@index([organizationId, siteId, visitedAt])
  @@index([organizationId, projectId, visitedAt])
  @@index([attendanceRecordId, visitedAt])
  @@index([organizationId, outletId, visitedAt])
}

model Outlet {
  id String @id @default(cuid())
  organizationId String
  projectId String
  code String?
  name String
  contactName String?
  phone String?
  address String?
  latitude Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  status LifecycleStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  visits VisitLog[]
  @@unique([organizationId, projectId, name])
  @@index([organizationId, projectId, status])
}

model DailySalesReport {
  id String @id @default(cuid())
  organizationId String
  employeeId String
  projectId String
  attendanceRecordId String @unique
  reportDate DateTime @db.Date
  status String @default("DRAFT")
  workerSummary String?
  additionalNote String?
  submittedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  attendanceRecord AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Restrict)
  visits DailySalesReportVisit[]
  @@index([organizationId, reportDate, status])
  @@index([organizationId, employeeId, reportDate])
}

model DailySalesReportVisit {
  id String @id @default(cuid())
  reportId String
  visitLogId String
  workerStatement String?
  structuredContext Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  report DailySalesReport @relation(fields: [reportId], references: [id], onDelete: Restrict)
  visitLog VisitLog @relation(fields: [visitLogId], references: [id], onDelete: Restrict)
  @@unique([reportId, visitLogId])
  @@index([reportId])
}

model TelegramConversationState {
  id String @id @default(cuid())
  organizationId String
  telegramUserId String
  state String
  context Json
  expiresAt DateTime
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId, state, expiresAt])
  @@unique([organizationId, telegramUserId])
}

model AttendanceRequest {
  id String @id @default(cuid())
  organizationId String
  employeeId String
  action AttendanceAction
  idempotencyKey String
  attendanceRecordId String?
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@unique([organizationId, employeeId, action, idempotencyKey])
}

model AttendanceCorrection {
  id String @id @default(cuid())
  organizationId String
  attendanceRecordId String
  requestedByUserId String?
  approvedByUserId String?
  status CorrectionStatus @default(PENDING)
  reason String
  correctedCheckInAt DateTime?
  correctedCheckOutAt DateTime?
  correctedStatus AttendanceStatus?
  originalCheckInAt DateTime?
  originalCheckOutAt DateTime?
  originalStatus AttendanceStatus?
  originalProjectId String?
  correctedProjectId String?
  resolutionNote String?
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  attendanceRecord AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Restrict)
  correctedProject Project? @relation("CorrectionProject", fields: [correctedProjectId], references: [id], onDelete: Restrict)
  @@index([organizationId, status])
  @@index([attendanceRecordId])
}

model AuditLog {
  id String @id @default(cuid())
  organizationId String
  actorUserId String?
  action String
  targetType String
  targetId String
  requestId String?
  metadata Json?
  occurredAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId, occurredAt])
  @@index([organizationId, targetType, targetId])
}

model TelegramUpdate {
  id String @id @default(cuid())
  updateId Int @unique
  processedAt DateTime @default(now())
  @@index([processedAt])
}

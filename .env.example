# Shared
NODE_ENV=development

# API only — never expose these to browser applications
PORT=5131
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Read-only concurrent probes before API readiness (0 disables; capped at 4 and connection_limit).
DATABASE_WARMUP_QUERIES=4
REDIS_URL=redis://localhost:6379
# Redis misses/outages fall back to authoritative reads; deadlines are milliseconds.
CACHE_REDIS_TIMEOUT_MS=40
CACHE_NAMESPACE=attendance-api
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_BOT_USERNAME=your_bot
TELEGRAM_HEALTH_SYNC_ENABLED=false
TELEGRAM_HEALTH_SYNC_INTERVAL_MS=900000
SESSION_SECRET=replace_with_long_random_secret

# Browser-safe only when intentionally public
NEXT_PUBLIC_API_URL=http://localhost:5131/api/v1
NEXT_PUBLIC_TELEGRAM_MINI_APP_URL=https://replace-me.example.com
# Optional browser timings: GPS, image rendering, HTTP duration and request correlation only.
NEXT_PUBLIC_DEBUG_REQUEST_TIMING=false

# Public HTTPS URL used by Telegram reply/inline Mini App buttons.
# Keep this equal to the currently active tunnel or deployed Mini App domain.
TELEGRAM_MINI_APP_URL=https://replace-me.example.com
